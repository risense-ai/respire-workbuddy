{
  "description": "respire memory hooks for WorkBuddy: SessionStart rules, per-round title-tier recall, Stop storage check (throttled, engine-verified). Review these hooks before trusting them.",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CODEBUDDY_PLUGIN_ROOT}/hooks/respire.py\" SessionStart || python \"${CODEBUDDY_PLUGIN_ROOT}/hooks/respire.py\" SessionStart",
            "timeout": 20,
            "statusMessage": "respire: injecting memory playbook"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CODEBUDDY_PLUGIN_ROOT}/hooks/respire.py\" UserPromptSubmit || python \"${CODEBUDDY_PLUGIN_ROOT}/hooks/respire.py\" UserPromptSubmit",
            "timeout": 20,
            "statusMessage": "respire: recalling memory"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CODEBUDDY_PLUGIN_ROOT}/hooks/respire.py\" Stop || python \"${CODEBUDDY_PLUGIN_ROOT}/hooks/respire.py\" Stop",
            "timeout": 20,
            "statusMessage": "respire: checking storage"
          }
        ]
      }
    ]
  }
}
